# Deliberately flawed host ruleset used by the test-suite.
table inet filter {
	set admin_v4 {
		type ipv4_addr
		flags interval
		elements = { 10.10.0.0/16, 192.0.2.10 }
	}

	set f2b {
		type ipv4_addr
		flags timeout
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept
		ct state established,related accept
		ct state invalid drop
		ip saddr @f2b drop
		tcp dport 22 ip saddr @admin_v4 accept
		tcp dport { 80, 443 } accept
		tcp dport 443 accept
		tcp dport 8443 drop
		tcp dport 8443 accept
		tcp dport 6379 accept
		tcp dport vmap { 5432 : jump db, 3306 : drop }
		udp dport 161 accept
		meta l4proto { icmp, ipv6-icmp } accept
		tcp dport 9100 ip saddr != 10.0.0.0/8 drop
		tcp dport 9100 accept
		limit rate 5/second log prefix "input drop: "
	}

	chain db {
		ip saddr 10.20.0.0/16 accept
		return
	}

	chain legacy {
		tcp dport 23 accept
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		accept
		ip daddr 10.0.0.0/8 drop
	}
}
